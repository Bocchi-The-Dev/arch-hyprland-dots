# ==============================================================================
#  kitty terminal configuration
#  kitty 0.49.x  |  Edited by hand. The old full-doc dump is saved next door as
#  `kitty.conf.sample` if you ever need the complete reference.
#
#  Keys use the "kitty_mod" default of (ctrl+shift), e.g. ctrl+shift+e to open
#  the config in $EDITOR. `kitty +kitten themes` lets you preview themes live.
# ==============================================================================


# ------------------------------------------------------------------------------
# Fonts
# ------------------------------------------------------------------------------
# A generic family usually, anything menu/monospace will do. Run
# `kitten choose-fonts` for a live preview picker.
# font_family      "JetBrainsMono Nerd Font"
# bold_font        auto
# italic_font      auto
# bold_italic_font auto

font_size        11.0

# Vertical/horizontal spacing tweaks (pts). Useful if glyphs feel cramped.
# adjust_line_height   0
# adjust_column_width  0

# never | always | cursor (disable in the last case only while the cursor sits
# on the glyph, which makes editing easier)
# disable_ligatures    never

# ------------------------------------------------------------------------------
# Cursor
# ------------------------------------------------------------------------------
# block | beam | underline
cursor_shape                beam
# 0 disables blinking; otherwise seconds between blinks
cursor_blink_interval       0
cursor_stop_blinking_after  15.0
cursor_text_color           #1e1e2e
# Cursor shape when the terminal window is unfocused
cursor_shape_unfocused      block

# ------------------------------------------------------------------------------
# Scrolling & history
# ------------------------------------------------------------------------------
scrollback_lines        10000
wheel_scroll_multiplier 5.0
touch_scroll_multiplier 1.0

# ------------------------------------------------------------------------------
# Mouse
# ------------------------------------------------------------------------------
# Hide the mouse cursor after this many seconds of inactivity
mouse_hide_wait        2.0
# clipboard | primary | clipboard-both | none
copy_on_select         clipboard
url_color              #f5e0dc
# never | hover | always
underline_hyperlinks   hover

# ------------------------------------------------------------------------------
# Shell integration (clean prompt clearing, exit-status, kitty @ control, ...)
# ------------------------------------------------------------------------------
shell_integration       enabled
# never | smart | always
strip_trailing_spaces   smart
# notify when a long-running command finishes: always | inactive | unfocused
# | never
notify_on_cmd_finish    unfocused

# ------------------------------------------------------------------------------
# Window appearance
# ------------------------------------------------------------------------------
remember_window_size      yes
initial_window_width      900c
initial_window_height     560c

# Padding around the text area (pts) -- a single number for all sides, or
# "top h-spacing v-spacing"
window_padding_width      4

# yes | titlebar-only | no
hide_window_decorations   titlebar-only
# 1.0 is fully opaque; lower it for a see-through terminal
background_opacity        1.0
# Requires a compositor (picom, kwin, ...)
# background_blur          8
# Toggle opacity live with ctrl+shift+m
dynamic_background_opacity yes

# Layouts available via ctrl+shift+l
enabled_layouts           splits,stack,grid,horizontal,vertical
placement_strategy        center

# ------------------------------------------------------------------------------
# Tab bar
# ------------------------------------------------------------------------------
# fade | slant | powerline | hidden
tab_bar_style             powerline
tab_bar_edge              top
tab_title_max_length      100
tab_title_template        "{index}: {title}"
active_tab_font_style     bold
inactive_tab_font_style   normal

# ------------------------------------------------------------------------------
# Performance
# ------------------------------------------------------------------------------
sync_to_monitor        yes
# In kitty 0.49 the old resize_draw_strategy was replaced by resize_in_steps,
# which snaps the window size to whole cells while resizing.
resize_in_steps        no
resize_debounce_time   0
draw_minimal_borders   yes

# ------------------------------------------------------------------------------
# Bell & notifications
# ------------------------------------------------------------------------------
enable_audio_bell       yes
# >0 switches from the audio bell to a visual flash
visual_bell_duration    0.0
window_alert_on_bell    yes
# 0 = never ask for confirmation when closing an OS window
confirm_os_window_close 0

# ------------------------------------------------------------------------------
# Keybindings (kitty_mod = ctrl+shift unless you change it below)
# ------------------------------------------------------------------------------
# kitty_mod ctrl+shift

# Copy / paste
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map shift+insert    paste_from_selection
map ctrl+shift+s    copy_path_to_clipboard

# Windows & tabs
map ctrl+shift+enter new_window_with_cwd
map ctrl+shift+n     new_os_window_with_cwd
map ctrl+shift+t     new_tab_with_cwd
map ctrl+shift+w     close_window
map ctrl+shift+q     close_os_window
map ctrl+shift+z     toggle_layout_stack

# Layouts & scrolling
map ctrl+shift+l         next_layout
map ctrl+shift+up        scroll_line_up
map ctrl+shift+down      scroll_line_down
map ctrl+shift+page_up   scroll_page_up
map ctrl+shift+page_down scroll_page_down
map ctrl+shift+home      scroll_home
map ctrl+shift+end       scroll_end
map ctrl+shift+h         show_scrollback

# Misc
map ctrl+shift+e   edit_config_file
map ctrl+shift+u   open_url
map ctrl+shift+.   increase_font_size
map ctrl+shift+,   decrease_font_size

# ------------------------------------------------------------------------------
# Colors - Catppuccin Mocha
# Run `kitty +kitten themes` to preview others and paste the colors below.
# ------------------------------------------------------------------------------
background            #1e1e2e
foreground            #cdd6f4
selection_background  #f5e0dc
selection_foreground  #1e1e2e

color0  #45475a
color1  #f38ba8
color2  #a6e3a1
color3  #f9e2af
color4  #89b4fa
color5  #f5c2e7
color6  #94e2d5
color7  #bac2de
color8  #585b70
color9  #f38ba8
color10 #a6e3a1
color11 #f9e2af
color12 #89b4fa
color13 #f5c2e7
color14 #94e2d5
color15 #a6adc8

# Tab bar colors
active_tab_foreground   #1e1e2e
active_tab_background   #cba6f7
inactive_tab_foreground #cdd6f4
inactive_tab_background #313244
tab_bar_background      #1e1e2e

# BEGIN_KITTY_FONTS
font_family      family="JetBrainsMono Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS